# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution:
    def replaceValueInTree(self, root: Optional[TreeNode]) -> Optional[TreeNode]:
        
        sumLevels = list()
        sumLevels.append(dict())
        sumLevels[-1][None] = 0
        totalLevels = list()
        totalLevels.append(0)
        
        def calculateLevelSum(root, level, parent):
            if not root:
                return
            
            if parent in sumLevels[level-1]:
                sumLevels[level-1][parent] += root.val
            
            if len(totalLevels) < level + 1:
                totalLevels.append(0)
            
            totalLevels[level] += root.val
            
            if len(sumLevels) < level + 1:
                sumLevels.append(dict())
            
            sumLevels[level][root] = 0
            
            calculateLevelSum(root.left, level+1, root)
            calculateLevelSum(root.right, level+1, root)
        
        calculateLevelSum(root, 1, None)
        
        def reassignValues(root, level, parent):
            if not root:
                return
            
            curValue = totalLevels[level] - sumLevels[level-1][parent]

            root.val = curValue
            reassignValues(root.left, level+1, root)
            reassignValues(root.right, level+1, root)
            
        reassignValues(root, 1, None)
        return root
        
